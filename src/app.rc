#include <windows.h>
#include "version.h"
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION QA_VERSION_NUM
 PRODUCTVERSION QA_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "alexander-62"
   VALUE "FileDescription", "QuickAudio — Quick Settings audio selectors"
   VALUE "FileVersion", QA_VERSION
   VALUE "ProductName", "QuickAudio"
   VALUE "ProductVersion", QA_VERSION
   VALUE "LegalCopyright", "Copyright (C) 2026 QuickAudio contributors; GPL-3.0-or-later"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
